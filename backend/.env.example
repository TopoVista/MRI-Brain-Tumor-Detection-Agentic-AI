APP_NAME=Agentic MRI Analysis Copilot API
APP_ENV=development
API_PREFIX=/api
STRICT_PAPER_CORE=false
SEED_KNOWLEDGE_BASE_ON_STARTUP=false
CACHE_ONNX_SESSIONS=false
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=120
SQLITE_PATH=storage/mri_copilot.db
CHROMA_PATH=chroma
STORAGE_PATH=storage/uploads
MRI_MODEL_PATH=../artifacts/models/cnn.onnx
CNN_MODEL_PATH=../artifacts/models/cnn.onnx
CNN_MODEL_URL=
RESNET50_MODEL_PATH=../artifacts/models/resnet50.onnx
RESNET50_MODEL_URL=
VGG16_MODEL_PATH=../artifacts/models/vgg16.onnx
VGG16_MODEL_URL=
INCEPTION_V3_MODEL_PATH=../artifacts/models/inception_v3.onnx
INCEPTION_V3_MODEL_URL=
MRI_CONFIDENCE_THRESHOLD=0.72
TOP_K_LITERATURE=3
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=local
OPENAI_MODEL=gpt-5-mini
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
